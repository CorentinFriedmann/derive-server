# Copie ce fichier en ".env" (sans le ".example") et remplis ta vraie clé.
# Ne commite JAMAIS le fichier ".env" — il doit rester dans .gitignore.

# Récupérable sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port local (les hébergeurs comme Railway/Render définissent PORT eux-mêmes,
# cette valeur ne sert qu'en développement local).
PORT=3000

# Secret de signature des cookies de session (comptes utilisateurs).
# Génère le tien avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Envoi d'email (bouton "Recevoir cet itinéraire par email").
# Compte gratuit sur https://resend.com — clé dans Dashboard > API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel : une fois un domaine vérifié sur Resend, remplace l'adresse de
# test par la tienne, ex. "Peacetrip <bonjour@ton-domaine.com>".
# RESEND_FROM=Peacetrip <onboarding@resend.dev>

# Analytics respectueux de la vie privée (Plausible, pas de cookie, pas de
# Google Analytics). Compte sur https://plausible.io (essai gratuit puis
# payant — pas de tier gratuit permanent) ou instance auto-hébergée.
# Laisse cette ligne absente/commentée pour ne rien charger du tout.
# ANALYTICS_DOMAIN=peacetrip.com
