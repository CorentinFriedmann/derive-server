# Copie ce fichier en ".env" (sans le ".example") et remplis ta vraie clé.
# Ne commite JAMAIS le fichier ".env" — il doit rester dans .gitignore.

# Récupérable sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port local (les hébergeurs comme Railway/Render définissent PORT eux-mêmes,
# cette valeur ne sert qu'en développement local).
PORT=3000
